.fvec projection[4]
.fvec tint
.constf constants(0.0, 1.0, 0.0, 0.0)
.out outpos position
.out outclr color
.out outuv texcoord0
.out outuv1 texcoord1
.out outuv2 texcoord2
.proc main
 mov r0.xyz, v0
 mov r0.w, constants.y
 dp4 outpos.x, projection[0], r0
 dp4 outpos.y, projection[1], r0
 dp4 outpos.z, projection[2], r0
 dp4 outpos.w, projection[3], r0
 mul outclr, tint, v1
 mov outuv, v2
 mov outuv1, v2
 mov outuv2, v2
 end
.end
