.fvec projection[4]
.fvec tint
.fvec stereo
.fvec filterOffset
.fvec filterOffsetNegative
.constf constants(0.0, 1.0, 0.0, 0.0)
.out outpos position
.out outclr color
.out outuv texcoord0
.out outuv1 texcoord1
.out outuv2 texcoord2
.proc main
 mov r0.xyz, v0
 mov r0.w, constants.y
 dp4 r1.x, projection[0], r0
 dp4 r1.y, projection[1], r0
 dp4 r1.z, projection[2], r0
 dp4 r1.w, projection[3], r0
 mul r2.x, stereo.xxxx, r1.zzzz
 mul r2.y, stereo.yyyy, r1.wwww
 add r2.x, r2.xxxx, r2.yyyy
 mul r2.y, stereo.zzzz, r1.wwww
 max r2.x, r2.xxxx, -r2.yyyy
 min r2.x, r2.xxxx, r2.yyyy
 add r1.y, r1.yyyy, r2.xxxx
 mov outpos, r1
 mul outclr, tint, v1
 mov outuv, v2
 add outuv1, filterOffset, v2
 add outuv2, filterOffsetNegative, v2
 end
.end
